// ============================================================
// IMPÉRIO ERP — Prisma Schema
// Multi-tenant SaaS ERP — PostgreSQL 16
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum DiscountScope {
  SALE
  ITEM
}

enum ReceivableStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
  OVERDUE
}

enum PayableStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
  OVERDUE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum UserRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
  COMPANY_OWNER
  COMPANY_ADMIN
  MANAGER
  SUPERVISOR
  EMPLOYEE
  VIEWER
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED_BY_BILLING
  SUSPENDED_BY_ADMIN
  TRIAL
  CANCELLED
  DELETED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum SubscriptionInterval {
  MONTHLY
  YEARLY
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum AddressType {
  BILLING
  SHIPPING
  PRIMARY
  SECONDARY
}

enum ProductType {
  PHYSICAL
  DIGITAL
  SERVICE
  KIT
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
  ARCHIVED
}

enum SaleStatus {
  DRAFT
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PIX
  BANK_TRANSFER
  CHECK
  INSTALLMENT
}

enum StockMovementType {
  ENTRY
  EXIT
  TRANSFER
  ADJUSTMENT
  RETURN
  LOSS
  INITIAL
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum FinancialTransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
  FAILED
}

enum AccountType {
  CHECKING
  SAVINGS
  CASH
  CREDIT_CARD
  INVESTMENT
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
}

enum NotificationType {
  SYSTEM
  BUSINESS
  SECURITY
  BILLING
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ACCESS_DENIED
  EXPORT
  IMPORT
}

enum EmploymentStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
  ON_LEAVE
}

enum WorkflowInstanceStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  DELEGATED
}

enum AiProviderType {
  OPENAI
  ANTHROPIC
  CUSTOM
}

enum SyncStatus {
  PENDING
  SYNCING
  COMPLETED
  FAILED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum ExternalUserType {
  CUSTOMER
  SUPPLIER
  PARTNER
}

// ─────────────────────────────────────────────────────────────
// SAAS PLATFORM ENTITIES
// ─────────────────────────────────────────────────────────────

model Plan {
  id             String               @id @default(uuid())
  name           String
  description    String?
  price          Decimal              @db.Decimal(10, 2)
  interval       SubscriptionInterval @default(MONTHLY)
  trialDays      Int                  @default(14)
  maxUsers       Int                  @default(5)
  maxProducts    Int                  @default(100)
  maxCustomers   Int                  @default(200)
  maxStorageMb   Int                  @default(1024)
  maxBranches    Int                  @default(1)
  maxApiRequests Int                  @default(10000)
  featuresJson   Json?                @default("{}")
  isActive       Boolean              @default(true)
  isPublic       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(uuid())
  companyId          String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  plan    Plan                  @relation(fields: [planId], references: [id])
  company Company               @relation(fields: [companyId], references: [id])
  history SubscriptionHistory[]

  @@index([companyId])
  @@map("subscriptions")
}

model SubscriptionHistory {
  id             String   @id @default(uuid())
  subscriptionId String
  fromPlanId     String?
  toPlanId       String?
  action         String
  reason         String?
  performedBy    String?
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@map("subscription_history")
}

// ─────────────────────────────────────────────────────────────
// CORE COMPANY / TENANT
// ─────────────────────────────────────────────────────────────

model Company {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  document     String?       @unique
  email        String?
  phone        String?
  website      String?
  logoUrl      String?
  status       CompanyStatus @default(TRIAL)
  timezone     String        @default("America/Sao_Paulo")
  locale       String        @default("pt-BR")
  currencyCode String        @default("BRL")
  settingsJson Json?         @default("{}")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  subscription            Subscription?
  users                   UserCompany[]
  customers               Customer[]
  products                Product[]
  categories              Category[]
  brands                  Brand[]
  suppliers               Supplier[]
  warehouses              Warehouse[]
  salesOrders             SaleOrder[]
  purchaseOrders          PurchaseOrder[]
  accounts                FinancialAccount[]
  transactions            FinancialTransaction[]
  departments             Department[]
  teams                   Team[]
  employeeProfiles        EmployeeProfile[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  taxConfigurations       TaxConfiguration[]
  costCenters             CostCenter[]
  saleDiscounts           SaleDiscount[]
  saleTaxes               SaleTax[]
  accountsReceivable      AccountsReceivable[]
  accountsPayable         AccountsPayable[]
  notificationPreferences NotificationPreference[]
  notificationTemplates   NotificationTemplate[]
  notificationQueues      NotificationQueue[]
  securityEvents          SecurityEvent[]
  userActivities          UserActivity[]
  reportConfigs           ReportConfig[]
  reportExecutions        ReportExecution[]
  webhookEndpoints        WebhookEndpoint[]
  webhookDeliveries       WebhookDelivery[]
  apiKeys                 ApiKey[]
  workflowDefinitions     WorkflowDefinition[]
  businessRules           BusinessRule[]
  workflowInstances       WorkflowInstance[]
  approvalRequests        ApprovalRequest[]

  analyticCubes          AnalyticCube[]
  dashboards             Dashboard[]
  kpiMetrics             KpiMetric[]
  materializedViewLogs   MaterializedViewLog[]
  aiProviderConfigs      AiProviderConfig[]
  promptTemplates        PromptTemplate[]
  aiAuditTrails          AiAuditTrail[]
  aiPolicies             AiPolicy[]
  mobileDevices          MobileDevice[]
  syncStates             SyncState[]
  pushNotificationTokens PushNotificationToken[]
  externalUsers          ExternalUser[]
  featureFlags           FeatureFlag[]
  usageQuotas            UsageQuota[]
  billingInvoices        BillingInvoice[]

  fiscalProfile     FiscalProfile?
  fiscalCertificate FiscalCertificate?
  fiscalSeries      FiscalSeries[]
  fiscalOperations  FiscalOperation[]
  taxRules          TaxRule[]

  nfes Nfe[]

  nfces Nfce[]

  ctes Cte[]

  mdfes Mdfe[]

  nfseProviders NfseProvider?
  nfses         Nfse[]

  spedGenerations SpedGeneration[]

  esocialEmployer  EsocialEmployer?
  reinfContributor ReinfContributor?
  dctfWebPeriods   DctfWebPeriod[]

  pixAccounts         PixAccount[]
  pixWebhooks         PixWebhook[]
  boletos             Boleto[]
  bankAccounts        BankAccount[]
  bankReconciliations BankReconciliation[]

  predictionLogs PredictionLog[]

  pluginInstallations PluginInstallation[]
  whiteLabelConfig    WhiteLabelConfig?

  regionalDeployments RegionalDeployment[]
  countryConfigs      CountryConfiguration[]
  kmsIntegration      KmsIntegration?
  regionalAudits      RegionalAudit[]

  developers          Developer[]
  entWebhookEndpoints EntWebhookEndpoint[]
  pluginLicenses      PluginLicense[]
  pluginPurchases     PluginPurchase[]

  opSamlProviders           OpSamlProvider[]
  opOidcProviders           OpOidcProvider[]
  opLdapConnectors          OpLdapConnector[]
  opAdConnectors            OpAdConnector[]
  opScimProvisionings       OpScimProvisioning[]
  opGroupSyncs              OpGroupSync[]
  opTenantIsolationPolicy   OpTenantIsolationPolicy?
  opResourceQuota           OpResourceQuota?
  opBillingPolicy           OpBillingPolicy?
  opTenantMigrations        OpTenantMigration[]
  opTenantBackups           OpTenantBackup[]
  opCrossRegionReplications OpCrossRegionReplication[]
  opDisasterRecoveries      OpDisasterRecovery[]
  opDataClassifications     OpDataClassification[]
  opRetentionPolicies       OpRetentionPolicy[]
  opLegalHolds              OpLegalHold[]
  opPrivacyEngine           OpPrivacyEngine?
  opThreatDetections        OpThreatDetection[]
  opSecurityPolicies        OpSecurityPolicy[]
  opReleaseChannel          OpReleaseChannel?

  @@index([slug])
  @@index([document])
  @@map("companies")
}

// ─────────────────────────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────────────────────────

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String
  firstName       String
  lastName        String
  avatarUrl       String?
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  companies               UserCompany[]
  refreshTokens           RefreshToken[]
  employeeProfile         EmployeeProfile?
  auditLogs               AuditLog[]               @relation("AuditUser")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  notificationQueues      NotificationQueue[]
  securityEvents          SecurityEvent[]
  userActivities          UserActivity[]
  reportExecutions        ReportExecution[]
  workflowInstances       WorkflowInstance[]
  approvalRequests        ApprovalRequest[]

  @@index([email])
  @@index([status])
  @@map("users")
}

model UserCompany {
  id        String   @id @default(uuid())
  userId    String
  companyId String
  role      UserRole @default(EMPLOYEE)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("user_companies")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  token      String    @unique
  deviceInfo String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────
// ORGANIZATION
// ─────────────────────────────────────────────────────────────

model Department {
  id                String   @id @default(uuid())
  companyId         String
  name              String
  description       String?
  managerEmployeeId String?
  parentId          String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company   Company           @relation(fields: [companyId], references: [id])
  parent    Department?       @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children  Department[]      @relation("DepartmentHierarchy")
  teams     Team[]
  employees EmployeeProfile[]

  @@index([companyId])
  @@map("departments")
}

model Team {
  id           String   @id @default(uuid())
  companyId    String
  departmentId String?
  name         String
  description  String?
  teamLeaderId String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company      @relation(fields: [companyId], references: [id])
  department Department?  @relation(fields: [departmentId], references: [id])
  members    TeamMember[]

  @@index([companyId])
  @@map("teams")
}

model TeamMember {
  id           String    @id @default(uuid())
  teamId       String
  employeeId   String
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?

  team     Team            @relation(fields: [teamId], references: [id])
  employee EmployeeProfile @relation(fields: [employeeId], references: [id])

  @@unique([teamId, employeeId])
  @@map("team_members")
}

model EmployeeProfile {
  id               String           @id @default(uuid())
  companyId        String
  userId           String           @unique
  departmentId     String?
  badgeId          String?
  jobTitle         String?
  employmentStatus EmploymentStatus @default(ACTIVE)
  hiredAt          DateTime?
  terminatedAt     DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  company    Company      @relation(fields: [companyId], references: [id])
  user       User         @relation(fields: [userId], references: [id])
  department Department?  @relation(fields: [departmentId], references: [id])
  teams      TeamMember[]

  @@index([companyId])
  @@map("employee_profiles")
}

// ─────────────────────────────────────────────────────────────
// CUSTOMERS
// ─────────────────────────────────────────────────────────────

model Customer {
  id          String         @id @default(uuid())
  companyId   String
  type        CustomerType   @default(INDIVIDUAL)
  name        String
  document    String?
  email       String?
  phone       String?
  status      CustomerStatus @default(ACTIVE)
  creditLimit Decimal?       @db.Decimal(15, 2)
  notes       String?
  tags        String[]       @default([])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  company     Company              @relation(fields: [companyId], references: [id])
  addresses   CustomerAddress[]
  contacts    CustomerContact[]
  sales       SaleOrder[]
  receivables AccountsReceivable[]

  @@unique([companyId, document])
  @@index([companyId])
  @@map("customers")
}

model CustomerAddress {
  id         String      @id @default(uuid())
  customerId String
  type       AddressType @default(PRIMARY)
  street     String
  number     String?
  complement String?
  district   String?
  city       String
  state      String
  zipCode    String
  country    String      @default("BR")
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
}

model CustomerContact {
  id         String   @id @default(uuid())
  customerId String
  name       String
  role       String?
  email      String?
  phone      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_contacts")
}

// ─────────────────────────────────────────────────────────────
// PRODUCTS, BRANDS, CATEGORIES & UNITS
// ─────────────────────────────────────────────────────────────

model Brand {
  id          String    @id @default(uuid())
  companyId   String
  name        String
  slug        String
  description String?
  logoUrl     String?
  website     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company  Company   @relation(fields: [companyId], references: [id])
  products Product[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@map("brands")
}

model UnitOfMeasure {
  id           String   @id @default(uuid())
  companyId    String?
  name         String
  abbreviation String
  isSystem     Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products Product[]

  @@index([companyId])
  @@map("units_of_measure")
}

model Category {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  slug        String
  description String?
  parentId    String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company    @relation(fields: [companyId], references: [id])
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@map("categories")
}

model Product {
  id             String        @id @default(uuid())
  companyId      String
  categoryId     String?
  type           ProductType   @default(PHYSICAL)
  status         ProductStatus @default(ACTIVE)
  sku            String
  name           String
  description    String?
  barcode        String?
  unit           String        @default("UN")
  costPrice      Decimal       @db.Decimal(15, 4)
  salePrice      Decimal       @db.Decimal(15, 4)
  minStockQty    Decimal       @default(0) @db.Decimal(15, 3)
  weight         Decimal?      @db.Decimal(10, 3)
  imageUrl       String?
  tags           String[]      @default([])
  attributesJson Json?         @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  company         Company             @relation(fields: [companyId], references: [id])
  category        Category?           @relation(fields: [categoryId], references: [id])
  stockMovements  StockMovement[]
  saleItems       SaleOrderItem[]
  purchaseItems   PurchaseOrderItem[]
  supplierLinks   ProductSupplier[]
  Brand           Brand?              @relation(fields: [brandId], references: [id])
  brandId         String?
  UnitOfMeasure   UnitOfMeasure?      @relation(fields: [unitOfMeasureId], references: [id])
  unitOfMeasureId String?
  InventoryLevel  InventoryLevel[]
  NfeItem         NfeItem[]
  NfceItem        NfceItem[]

  @@unique([companyId, sku])
  @@index([sku])
  @@index([status])
  @@index([companyId])
  @@map("products")
}

// ─────────────────────────────────────────────────────────────
// SUPPLIERS
// ─────────────────────────────────────────────────────────────

model Supplier {
  id           String         @id @default(uuid())
  companyId    String
  name         String
  document     String?
  email        String?
  phone        String?
  website      String?
  status       SupplierStatus @default(ACTIVE)
  notes        String?
  paymentTerms String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  company        Company           @relation(fields: [companyId], references: [id])
  productLinks   ProductSupplier[]
  purchaseOrders PurchaseOrder[]
  payables       AccountsPayable[]

  @@unique([companyId, document])
  @@index([companyId])
  @@map("suppliers")
}

model ProductSupplier {
  id            String   @id @default(uuid())
  productId     String
  supplierId    String
  supplierSku   String?
  supplierPrice Decimal? @db.Decimal(15, 4)
  minOrderQty   Decimal? @db.Decimal(15, 3)
  leadTimeDays  Int?
  isPreferred   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product  Product  @relation(fields: [productId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@unique([productId, supplierId])
  @@map("product_suppliers")
}

// ─────────────────────────────────────────────────────────────
// INVENTORY
// ─────────────────────────────────────────────────────────────

model Warehouse {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  description String?
  address     String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id])
  stockMovements  StockMovement[]
  inventoryLevels InventoryLevel[]

  @@index([companyId])
  @@map("warehouses")
}

model StockMovement {
  id            String            @id @default(uuid())
  companyId     String
  warehouseId   String
  productId     String
  type          StockMovementType
  quantity      Decimal           @db.Decimal(15, 3)
  unitCost      Decimal?          @db.Decimal(15, 4)
  referenceId   String?
  referenceType String?
  batchNumber   String?
  expiresAt     DateTime?
  notes         String?
  performedBy   String?
  createdAt     DateTime          @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@index([companyId])
  @@map("stock_movements")
}

model InventoryLevel {
  id          String   @id @default(uuid())
  companyId   String
  warehouseId String
  productId   String
  quantity    Decimal  @default(0) @db.Decimal(15, 3)
  reservedQty Decimal  @default(0) @db.Decimal(15, 3)
  updatedAt   DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
  @@index([companyId])
  @@map("inventory_levels")
}

// ─────────────────────────────────────────────────────────────
// SALES
// ─────────────────────────────────────────────────────────────

model SaleOrder {
  id                 String     @id @default(uuid())
  companyId          String
  customerId         String?
  sellerId           String?
  orderNumber        String
  status             SaleStatus @default(DRAFT)
  subtotal           Decimal    @db.Decimal(15, 2)
  discountAmount     Decimal    @default(0) @db.Decimal(15, 2)
  taxAmount          Decimal    @default(0) @db.Decimal(15, 2)
  totalAmount        Decimal    @db.Decimal(15, 2)
  notes              String?
  confirmedAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  company      Company              @relation(fields: [companyId], references: [id])
  customer     Customer?            @relation(fields: [customerId], references: [id])
  costCenter   CostCenter?          @relation(fields: [costCenterId], references: [id])
  costCenterId String?
  items        SaleOrderItem[]
  payments     SalePayment[]
  discounts    SaleDiscount[]
  taxes        SaleTax[]
  receivables  AccountsReceivable[]
  Nfe          Nfe?
  Nfce         Nfce?

  @@unique([companyId, orderNumber])
  @@index([companyId])
  @@map("sale_orders")
}

model SaleOrderItem {
  id             String   @id @default(uuid())
  saleOrderId    String
  productId      String
  productName    String
  productSku     String
  quantity       Decimal  @db.Decimal(15, 3)
  unitPrice      Decimal  @db.Decimal(15, 4)
  discountPct    Decimal  @default(0) @db.Decimal(5, 2)
  discountAmount Decimal  @default(0) @db.Decimal(15, 2)
  totalAmount    Decimal  @db.Decimal(15, 2)
  createdAt      DateTime @default(now())

  saleOrder SaleOrder @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@map("sale_order_items")
}

model SalePayment {
  id          String        @id @default(uuid())
  saleOrderId String
  method      PaymentMethod
  amount      Decimal       @db.Decimal(15, 2)
  reference   String?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  saleOrder SaleOrder @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)

  @@map("sale_payments")
}

// ─────────────────────────────────────────────────────────────
// PURCHASING
// ─────────────────────────────────────────────────────────────

model PurchaseOrder {
  id          String              @id @default(uuid())
  companyId   String
  supplierId  String
  orderNumber String
  status      PurchaseOrderStatus @default(DRAFT)
  subtotal    Decimal             @db.Decimal(15, 2)
  taxAmount   Decimal             @default(0) @db.Decimal(15, 2)
