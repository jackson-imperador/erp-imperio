# App Configuration
NODE_ENV=production
APP_PORT=3000

# Database
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=erp_imperio
DATABASE_URL=postgresql://postgres:postgres@db:5432/erp_imperio?schema=public

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ROOT_USER=admin_prod
MINIO_ROOT_PASSWORD=prod_secure_minio_password
MINIO_USE_SSL=true
MINIO_BUCKET=erp-imperio

# JWT
JWT_ACCESS_SECRET=super-secret-key-production-replace-me
JWT_REFRESH_SECRET=super-secret-key-production-replace-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Third Party APIs
API_KEY_GATEWAY=prod_key_replace_me

# Grafana
GRAFANA_PASSWORD=admin_prod_grafana_password
