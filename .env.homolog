# App Configuration
NODE_ENV=homolog
PORT=3000

# Database
DB_HOST=db_homolog
DB_PORT=5432
DB_USER=homolog_user
DB_PASSWORD=homolog_password
DB_NAME=erp_imperio_homolog

# Redis
REDIS_HOST=redis_homolog
REDIS_PORT=6379

# MinIO
MINIO_ENDPOINT=minio_homolog
MINIO_PORT=9000
MINIO_ROOT_USER=admin_homolog
MINIO_ROOT_PASSWORD=admin123_homolog
MINIO_USE_SSL=false
MINIO_BUCKET=erp-imperio

# JWT
JWT_SECRET=super-secret-key-homolog
JWT_EXPIRATION=1d

# Third Party APIs
API_KEY_GATEWAY=homolog_key
